# Optional OpenAI-compatible verifier configuration.
# Leave blank to run only the local deterministic matcher.
PROMOBRIDGE_API_KEY=
PROMOBRIDGE_MODEL=gpt-4o-mini
# PROMOBRIDGE_BASE_URL=https://provider.example/v1

# Optional initial decision thresholds (not calibrated probabilities).
PROMOBRIDGE_HIGH_SCORE_THRESHOLD=0.82
PROMOBRIDGE_LOW_SCORE_THRESHOLD=0.60
PROMOBRIDGE_MIN_MARGIN=0.08
PROMOBRIDGE_MIN_TOKENS=4
